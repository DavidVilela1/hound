# Hound configuration — copy to .env and adjust. Every variable is optional.
# All names use the HOUND_ prefix (see README, "Configuration").
# Relative paths are resolved against the project directory.

# --- Server (keep it on localhost unless you know why not) -----------------------
HOUND_HOST=127.0.0.1
HOUND_PORT=8000
# Host-header allow-list (DNS-rebinding protection). Add your LAN name/IP if you
# deliberately bind to a non-loopback address.
HOUND_ALLOWED_HOSTS=127.0.0.1,localhost,::1
# URL the dashboard and the capture daemon use to reach the API (default: derived from HOST/PORT)
# HOUND_API_URL=http://127.0.0.1:8000
HOUND_ENABLE_DASHBOARD=true

# --- Storage --------------------------------------------------------------------------
HOUND_DATABASE_URL=sqlite:///data/hound.db
# Oldest events are deleted beyond this many rows.
HOUND_RETENTION_MAX_EVENTS=250000
# Also delete events older than this many days (unset = no age limit), e.g. 30.
# HOUND_RETENTION_DAYS=30

# --- Capture ----------------------------------------------------------------------------
# Interface name as printed by `python run.py interfaces` (empty = system default)
HOUND_NETWORK_INTERFACE=
HOUND_BPF_FILTER=udp port 53 or tcp port 53 or (tcp[tcpflags] & tcp-syn != 0)
# Where Hound captures, which decides what it can see (README: "Where to run Hound"):
# this_computer | gateway | mirror | dns_server. Unset (auto): Hound describes what it
# sees from the traffic.
# HOUND_DEPLOYMENT_POSITION=this_computer
# Shared secret between the capture daemon and the API. Leave unset to use the
# auto-generated token file below (created by the server with 0600 permissions).
# HOUND_INGEST_TOKEN=
HOUND_INGEST_TOKEN_PATH=data/.ingest_token

# --- Pipeline -----------------------------------------------------------------------------
HOUND_QUEUE_MAX_SIZE=10000
HOUND_BATCH_SIZE=200
HOUND_FLUSH_INTERVAL_SECONDS=0.5
HOUND_WS_CLIENT_QUEUE_SIZE=500
HOUND_MAX_PAGE_SIZE=500

# --- Enrichment ------------------------------------------------------------------------
HOUND_BLOCKLIST_PATH=config/blocklist.txt
# Domains and devices whose indicators are not counted (see the file for the rules).
HOUND_ALLOWLIST_PATH=config/allowlist.txt
# Signal weights and thresholds (all commented = built-in defaults). HOUND_RISK_* below win.
HOUND_RISK_CONFIG_PATH=config/risk.toml
# Countries: auto (default) = the free DB-IP Lite database, downloaded automatically into
# HOUND_GEOIP_DIR and updated monthly ("IP Geolocation by DB-IP", CC BY 4.0).
# Only for demos: simulated / mapping_only (illustrative, NOT real data).
# HOUND_GEO_MODE=auto
# HOUND_GEOIP_DIR=data/geoip
# Set to false to never contact download.db-ip.com (then: python run.py geo update).
# HOUND_GEOIP_AUTO_UPDATE=true
HOUND_GEO_RANGES_PATH=config/geo_ranges.csv
HOUND_DNS_CACHE_SIZE=10000
HOUND_DNS_CACHE_TTL_SECONDS=3600

# --- Risk engine (see README, "Risk scoring") ------------------------------------------
# Tune detection in config/risk.toml (weights, thresholds, lists). The variables below
# are left commented on purpose: any of them you set OVERRIDES the file for that value.
# HOUND_RISK_SUSPICIOUS_THRESHOLD=25
# HOUND_RISK_DANGEROUS_THRESHOLD=70
# HOUND_RISK_WINDOW_SECONDS=60
# HOUND_RISK_REPEATED_ATTEMPTS_THRESHOLD=15
# HOUND_RISK_PORT_SCAN_THRESHOLD=15
# HOUND_RISK_HOST_SWEEP_THRESHOLD=20
# HOUND_RISK_NXDOMAIN_THRESHOLD=10
# HOUND_RISK_SUSPICIOUS_PORTS=23,135,139,445,1433,3389,4444,5900,6667
# HOUND_RISK_COMMON_PORTS=53,80,123,443,853,993,995,465,587,5222,5223,8080,8443
# HOUND_RISK_RISKY_TLDS=zip,mov,xyz,top,tk,gq,ml,cf,click,country,work
# Your resolvers, e.g. 192.168.1.1 - enables the "untrusted resolver" signal when set
# HOUND_TRUSTED_DNS_SERVERS=
HOUND_DEVICE_RISK_WINDOW_MINUTES=60

# --- Demo mode ------------------------------------------------------------------------------
HOUND_DEMO_EVENTS_PER_SECOND=4
# HOUND_DEMO_SEED=42

# --- Logging ----------------------------------------------------------------------------------
HOUND_LOG_LEVEL=INFO
# text or json
HOUND_LOG_FORMAT=text
